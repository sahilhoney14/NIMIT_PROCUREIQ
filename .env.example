# ==============================================================================
# Master Environment Variables Template - ProcureIQ
# Copy this file to .env in each corresponding service folder under /backend
# ==============================================================================

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=ProcureIQ
DB2_NAME=ProcureIQ_Logs

# Service Ports & Endpoints
AUTH_SERVICE_PORT=3000
AUTH_SERVICE_URL=http://localhost:3000

ADMIN_SERVICE_PORT=3001
ADMIN_SERVICE_URL=http://localhost:3001

PROCUREMENT_MANAGER_SERVICE_PORT=3002
PROCUREMENT_MANAGER_SERVICE_URL=http://localhost:3002

PROCUREMENT_SERVICE_PORT=3003
PROCUREMENT_SERVICE_URL=http://localhost:3003

# Security Secrets
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
