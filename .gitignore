# ==============================================================================
# Enterprise .gitignore - ProcureIQ
# ==============================================================================

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment and sensitive keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Runtime generated documents and user uploads
backend/purchase-orders/*.pdf
backend/proforma-invoice/*
backend/vendor/*
backend/uploads/*
!backend/purchase-orders/.gitkeep
!backend/proforma-invoice/.gitkeep
!backend/vendor/.gitkeep

backend/storage/*/*
!backend/storage/**/.gitkeep

# System & IDE files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*.log
*.suo
*.ntvs*
*.njsproj

# Application Logs
*.log
logs/

# Legacy backup services
legacy_services/
